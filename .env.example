# ─── OMS frontend ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and adjust. Every value has a development default, so the
# app starts with none of them set. Public values are read in `src/config/env.ts`;
# server-only ones in `src/config/server-env.ts`.

# ─── Public (inlined into the browser bundle) ─────────────────────────────────

# Where the screens send their requests. The default is this app's own proxy,
# which reads the access token from an httpOnly cookie and attaches it
# server-side — the browser never holds a credential.
# Set it to `/api/mock` to run the whole app against the in-repo mock with no
# backends at all. Useful for UI work.
NEXT_PUBLIC_OMS_API_BASE=/api/oms

# Origins allowed to frame OMS and to send it host messages: the theme, and the
# access token. Comma-separated. `next.config.ts` parses the same variable for
# the `frame-ancestors` CSP — the two are halves of one trust decision, and a
# list that allows framing but not messaging fails in a way that looks like a
# bug in the host.
NEXT_PUBLIC_EMBED_HOST_ORIGINS=http://localhost:4200,https://fonepoints-business.vercel.app

# ─── Server-only (never prefix these NEXT_PUBLIC_) ────────────────────────────

# Where the OMS backend answers. Reached only by this app's server, from
# `/api/session` and `/api/oms/*`.
OMS_BACKEND_URL=http://localhost:3001

# Where the access token comes from.
#   host — the real flow: the Fonepoints portal frames OMS and sends a token it
#          obtained from its own backend. Nothing else can produce a session.
#   dev  — additionally allows POST /api/session/dev, which mints a token with
#          the API key below so the standalone dashboard works with no portal.
# Defaults to `dev` outside production, and is FORCED to `host` in production:
# a frontend that can mint its own sessions is not an authentication boundary.
OMS_AUTH_MODE=dev

# Used only by the `dev` mint above. In the real flow this key lives in the
# Fonepoints backend and this app never sees it. Must match
# OMS_COMPANY_API_KEY in `oms-backend`.
OMS_DEV_API_KEY=

# Which merchant the `dev` mint signs in as: an `externalRef` from the OMS
# registration (`fp-hamro-mobile` or `fp-gadget-ghar` in the seed).
OMS_DEV_MERCHANT_REF=fp-hamro-mobile
