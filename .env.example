# ─── OMS frontend ─────────────────────────────────────────────────────────────
# Copy to `.env.local` if you need to change anything; every value has a
# development default. Public values are read in `src/config/env.ts`;
# server-only ones in `src/config/server-env.ts`.
# How the pieces fit together: docs/sales-api-integration.md

# ─── Public (inlined into the browser bundle) ─────────────────────────────────

# Origins allowed to frame OMS and to send it host messages: the theme, and the
# access token. Comma-separated. `next.config.ts` parses the same variable for
# the `frame-ancestors` CSP — the two are halves of one trust decision, and a
# list that allows framing but not messaging fails in a way that looks like a
# bug in the host. Production: the production portal origin only.
NEXT_PUBLIC_EMBED_HOST_ORIGINS=http://localhost:4200,https://fonepoints-business.vercel.app

# Trace logging for testing the authentication flow. Always on under `next dev`;
# set to 1 to turn it on in a build. Lines are prefixed `[OMS:…]` and tagged with the
# step numbers from the flow document; tokens and keys are never printed. In a
# deployed build you can also turn it on per browser: in the DevTools console of
# the OMS frame, `localStorage.setItem("oms:debug", "1")`, then reload.
NEXT_PUBLIC_OMS_DEBUG=

# ─── Server-only (never prefix these NEXT_PUBLIC_) ────────────────────────────

# The Sales service: `{SALES_URL}` in src/api.md. The merchant portal API is
# under `{SALES_URL}api/oms/portal/`, the rider endpoint under
# `{SALES_URL}api/oms/rider/`. Defaults to the development Sales service
# outside production; a production build has no default and must set it.
OMS_SALES_URL=https://dev-sales-api.providhy.com/

# Server-side trace lines (session route, proxy) in a production run. NEXT_PUBLIC_OMS_DEBUG=1
# above also turns them on. Refused requests and refused tokens are always logged.
OMS_DEBUG=
